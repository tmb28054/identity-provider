# ADFS/LDAP connection configuration
# Copy this file to adfs_config.yaml and fill in your values.
# Alternatively, run with --adfs-config adfs_config.yaml and you'll be prompted.

# LDAP server hostname or IP (use ldaps:// prefix for TLS)
host: "ldaps://dc01.corp.example.com"

# Service account for LDAP bind (used to search for users)
username: "CN=svc-idp,OU=Service Accounts,DC=corp,DC=example,DC=com"

# Base DN for user searches
base_dn: "DC=corp,DC=example,DC=com"

# Service account password
password: "your-service-account-password"

# Path to a PEM bundle for a private/internal CA (optional).
# When set, ldaps:// server certificates are validated against this CA in
# addition to the system trust store. Use this to trust an internal issuer
# WITHOUT disabling verification. Leave unset to use the system trust store.
# ca_certs_file: "/etc/idp/internal-ca.pem"

# Skip TLS certificate verification for LDAP connections (optional, default: false)
# WARNING: this disables validation entirely and exposes the bind — including
# the user's cleartext password and the memberOf groups that drive AWS role
# mapping — to man-in-the-middle attacks. Prefer ca_certs_file for internal
# CAs. Only enable for throwaway development environments. A WARNING is logged
# on every authentication when this is active.
# skip_ssl_verify: true
